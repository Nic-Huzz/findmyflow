<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs JIT for V8 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Electron needs to allocate executable memory at runtime -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading dynamic libraries (e.g. node-pty native modules) -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- node-pty spawns child processes (the user's terminal shell) -->
  <key>com.apple.security.inherit</key>
  <true/>

  <!-- Network access (the embedded Express server + WebSocket) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- File access — the user picks projects/folders to work on -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
