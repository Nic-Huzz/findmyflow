{
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "https://qlwfcfypnoptsocdpxuv.supabase.co/functions/v1/mcp-server"
    },
    {
      "source": "/Vibe-Rise-Game",
      "destination": "/vibe-rise-game.html"
    },
    {
      "source": "/vibe-rise-game",
      "destination": "/vibe-rise-game.html"
    },
    {
      "source": "/vibe-rise-shift",
      "destination": "/vibe-rise-shift.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}


