{
	"appId": "com.nichuzz.viberise",
	"appName": "Vibe Rise",
	"webDir": "dist",
	"server": {
		"url": "https://viberise.nichuzz.com",
		"cleartext": false
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#ffffff",
		"scrollEnabled": true,
		"allowsLinkPreview": false
	},
	"android": {
		"backgroundColor": "#0a0a0f",
		"allowMixedContent": false,
		"useLegacyBridge": false
	},
	"plugins": {
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#0a0a0f"
		},
		"SplashScreen": {
			"backgroundColor": "#0a0a0f",
			"launchAutoHide": true,
			"launchShowDuration": 1000
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"LocalNotificationsPlugin",
		"PushNotificationsPlugin"
	]
}
